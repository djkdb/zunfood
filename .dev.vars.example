# Cloudflare Worker 로컬 실행용 (wrangler dev 가 읽습니다)
# 이 파일을 .dev.vars 로 복사한 뒤 Neon 커넥션 문자열을 넣으세요.
# .dev.vars 는 커밋되지 않습니다.
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/mealgame?sslmode=require

# 실제 식당 데이터를 쓸 때만 필요합니다. 둘 다 있으면 구글을 우선 사용합니다.
#
# 카카오 (이름·카테고리·거리): 개발자센터 > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=
# 구글 (평점·가격대·영업여부·사진): GCP > API 및 서비스 > 사용자 인증 정보
GOOGLE_PLACES_API_KEY=
# 구글 월 호출 상한. 넘으면 카카오로 자동 전환합니다 (기본 900).
# 구글 무료 한도가 월 1,000건이라 여유를 두고 잡습니다.
GOOGLE_MONTHLY_LIMIT=900
