# ─────────────────────────────────────────────
# MEALGAME 환경변수
# 이 파일을 .env 로 복사해서 사용하세요. (.env 는 커밋되지 않습니다)
# 아무것도 설정하지 않아도 앱은 "로컬 모드"로 완전히 동작합니다.
# ─────────────────────────────────────────────

# [실시간 동기화] 방 API 주소
# Cloudflare Pages 에 배포하면 '/api' 로 두면 됩니다.
# 비워두면 같은 기기의 여러 탭끼리만 동기화되는 로컬 모드로 동작합니다.
VITE_API_BASE=

# ─────────────────────────────────────────────
# 아래는 서버(Cloudflare Pages Functions) 전용입니다.
# VITE_ 접두사를 붙이면 브라우저에 노출되므로 절대 붙이지 마세요.
# 로컬에서는 .dev.vars 파일에, 배포에서는 Worker 의 Secret 에 넣습니다.
#
#   DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require
#   KAKAO_REST_API_KEY=<카카오 REST API 키>
#   GOOGLE_PLACES_API_KEY=<구글 Places API 키>   ← 있으면 이쪽을 우선 사용
# ─────────────────────────────────────────────

# [식당 데이터] mock | kakao | google
# mock:   내장 목업 데이터 (기본값, 서버 없이도 동작)
# kakao:  카카오 로컬 API — 이름·카테고리·거리만
# google: 구글 Places(New) — 평점·가격대·영업여부·사진까지
#
# kakao/google 은 서버(/api/places)를 통해 가져오므로 VITE_API_BASE 와
# 서버의 API 키가 함께 필요합니다. 서버에 넣은 키와 이 값을 맞춰주세요.
VITE_PLACES_PROVIDER=mock

# [AI 판사] mock | http
# mock: 결정론적 목업 판결(기본값)
# http: 아래 엔드포인트로 판결을 위임 (LLM API 키는 반드시 서버에 보관)
VITE_AI_JUDGE_PROVIDER=mock
VITE_AI_JUDGE_ENDPOINT=
