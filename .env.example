# ─────────────────────────────────────────────
# MEALGAME 환경변수
# 이 파일을 .env 로 복사해서 사용하세요. (.env 는 커밋되지 않습니다)
# 아무것도 설정하지 않아도 앱은 "로컬 모드"로 완전히 동작합니다.
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
# 아래 VITE_ 값들은 보통 건드릴 필요가 없습니다.
# 배포 빌드는 기본적으로 /api + 카카오를 사용합니다.
# ─────────────────────────────────────────────

# [실시간 동기화] 방 API 주소
# 배포에서는 기본 '/api', 로컬 개발에서는 기본 없음(로컬 모드)입니다.
# 배포에서도 로컬 모드로 두고 싶으면 빈 값으로 명시하세요.
# VITE_API_BASE=

# ─────────────────────────────────────────────
# 아래는 서버(Cloudflare Pages Functions) 전용입니다.
# VITE_ 접두사를 붙이면 브라우저에 노출되므로 절대 붙이지 마세요.
# 로컬에서는 .dev.vars 파일에, 배포에서는 Worker 의 Secret 에 넣습니다.
#
#   DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require
#   KAKAO_REST_API_KEY=<카카오 REST API 키>
#   GOOGLE_PLACES_API_KEY=<구글 Places API 키>   ← 있으면 이쪽을 우선 사용
#   GOOGLE_MONTHLY_LIMIT=900                      ← 넘으면 카카오로 자동 전환
# ─────────────────────────────────────────────

# [식당 데이터] mock | kakao | google   (기본값: kakao)
# mock:   내장 데모 데이터
# kakao:  카카오 로컬 API — 이름·카테고리·거리만 (무료, 일 10만)
# google: 구글 Places(New) — 평점·가격대·영업여부·사진까지 (월 1,000건 무료)
#
# 서버에 키가 없으면 자동으로 데모 데이터로 동작하므로 앱이 죽지 않습니다.
# 구글을 쓸 때만 아래를 google 로 바꿔주세요.
# VITE_PLACES_PROVIDER=kakao

# [AI 판사] mock | http
# mock: 결정론적 목업 판결(기본값)
# http: 아래 엔드포인트로 판결을 위임 (LLM API 키는 반드시 서버에 보관)
VITE_AI_JUDGE_PROVIDER=mock
VITE_AI_JUDGE_ENDPOINT=
